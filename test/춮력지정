'''

# 4. 합치기 : a.join()

'''
text = 'abcde'
print('/'.join(text))   # 슬래쉬(/)를 넣어줌. a/b/c/d/e
'''

# 5. 개수 확인하기 : count(a)

'''
text = 'abcde ABC ABC'
print(text.count('a'))    # a의 갯수를 표기
print(text.count('A'))    # 대문자 A의 갯수를 표기
print(text.count('1'))    # 숫자 1을 갯수로 표기
'''

# 6. 제거하기 : strip(a) / lstrip(a) / rstrip(a)

'''
text = ' abcde '
print(text.strip())     # 앞뒤부분의 공백을 제거
print(text.lstrip())    # 왼쪽부분의 공백 제거 
print(text.rstrip())    # 오른쪽 공백 제거
'''

'''
text = '***ab**cde*****'
print(text.strip('*'))     # 왼쪽,오른쪽 별표는 제거, 그러나 중간에 별표는 제거 못함
print(text.lstrip('*'))    # 왼쪽부분의 별표만 제거
print(text.rstrip('*'))    # 오른쪽 별표만 제거
'''

# 7. 인덱스 찾기 : find(a) / rfind(a) / index(a) / rindex(a)

# ABC ABC => 순서가 0,1,2,3,4,5,6,.... 이런 순서로 나열 되어 있슴
# 0123456

'''
text = 'ABC ABC'
print(text.find('A'))       # 왼쪽부터 A를 찾는다. 단, 중복된것은 처음에 포함되어 '0' 번 자리에 다 포함시킴
print(text.rfind('A'))      # 오른쪽부터 찾음.
print(text.index('A'))      # find와 같은. 둘 중 어느것을 사용해도 무방
print(text.rindex('A'))     # 단 index에서 d를 찾으라고 했을 때는 인덱스는 '에러' 표기
'''

'''
text = 'ABC ABC'
print(text.find('d'))
print(text.rfind('d'))
print(text.index('d'))
print(text.rindex('d'))
'''

# 8. 확인하기 : isalpha() / isdigit() / isalnum() / isupper() / islower

text1 = 'ABCabc123'
text2 = '123'
text3 = 'ABC'
text4 = 'abc'

'''
print(text1.isalpha())      # text1의 알파벳이 대문자인가를 묻는 것
print(text1.isdigit())      # text1이 숫자로만 이루어져 있는가를 묻는 것
print(text1.isalnum())      # text1이 알파벳과 숫자로 이루어져 있는가를 묻는 것.
print(text1.isupper())      # text1이 대문자로만 이루어져 있는가를 묻는 것.
print(text1.islower())      # text1이 소문자로만 이루어져 있는가를 묻는 것.
'''

