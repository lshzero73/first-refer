# 2. 대체하기 : replace(a,b)
'''
text = 'abcde ABC ABC'
print(text.replace('ABC','KKK'))  # 대문자 ABC를 대문자 KKK로 바꿔줌.
print(text.replace('A','K'))      # 대문자 A를 대문자 K로 바꿔줌. 
'''

# 3. 자르기 : split(a)
'''
text = 'abcde A/B/C A.B.C'
#a,b,c=text.split()       # 빈칸 부분만을 나눠서 출력
#a,b,c=text.split('.')    # 점(.) 부분만을 나눠서 표기 
a,b,c=text.split('/')     # 슬래쉬(/)부분까지 각각 나눠서 표기
